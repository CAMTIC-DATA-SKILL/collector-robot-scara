# 이 파일을 .env 로 복사해서 쓴다. 비워 둔 값은 config.py 의 기본값을 따른다.

# Remote Ethernet 프레임 맵 (저장소 루트 기준 상대경로 또는 절대경로)
SOCKET_MAP_FILE=socket_map.json

# RC90 컨트롤러. Remote Ethernet 포트는 RC+ 에 저장된 값을 쓴다. 설명서 기본값은 5000.
SOCKET_HOST=192.168.1.121
SOCKET_PORT=5000
SOCKET_TIMEOUT_SEC=5.0

# Remote Control / Ethernet 에 넣은 비밀번호. 쉼표와 큰따옴표는 쓸 수 없다.
REMOTE_PASSWORD=

# 수집 주기. 컨트롤러 Remote Ethernet timeout 보다 짧아야 세션이 유지된다.
POLL_INTERVAL_SEC=1.0
RECONNECT_INTERVAL_SEC=5.0

# 로깅: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 게이트웨이 IPC (ZeroMQ). data/health/ack PUB, cmd_r/cmd_w SUB
# 토픽: collector.robot.{DEVICE_KEY}.{msg_type}. DEVICE_KEY 에 '.' 금지
DEVICE_KEY=scara-rc90
GATEWAY_ADDRESS=gateway
# 미들웨어 SUB. 이 수집기는 connect 한다.
ZMQ_PUB_ENDPOINT=tcp://127.0.0.1:5556
ZMQ_SUB_ENDPOINT=tcp://127.0.0.1:5555
ZMQ_PUB_BIND=false
ZMQ_SUB_BIND=false
ZMQ_RECV_TIMEOUT_MS=100
ZMQ_LINGER_MS=0
